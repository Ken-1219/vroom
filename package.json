{
  "name": "vroom",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "seed": "turbo seed",
    "seed:all": "pnpm --filter @vroom/db seed"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/*"
    ],
    "overrides": {
      "drizzle-orm": "0.44.7"
    }
  },
  "devDependencies": {
    "next": "16.2.5",
    "turbo": "^2.9.9"
  }
}
