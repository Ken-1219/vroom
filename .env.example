# Database (Neon free tier or local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vroom

# Redis (Upstash free tier or local Docker)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth.js v5)
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# OAuth (optional — app works without these, using demo accounts only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Maps (Mapbox free tier — 50K loads/month)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# AI Providers (all free tiers)
GOOGLE_AI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
CLOUDFLARE_AI_TOKEN=your-cf-ai-token
HF_API_KEY=your-huggingface-api-key

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
